{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x-asset.schema.json",
  "title": "x-asset",
  "description": "A STIX 2.1 SDO representing a physical space asset such as a payload, satellite, or rocket body.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "x-asset"
    },
    "spec_version": {
      "type": "string",
      "const": "2.1"
    },
    "id": {
      "type": "string",
      "pattern": "^x-asset--[0-9a-fA-F-]{36}$"
    },
    "created_by_ref": {
      "type": "string",
      "pattern": "^identity--[0-9a-fA-F-]{36}$"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "description": "Type of physical space asset, such as payload, satellite, or rocket-body."
    },
    "norad_number": {
      "type": "integer",
      "minimum": 0,
      "description": "NORAD catalog number assigned to the space object."
    },
    "international_designator": {
      "type": "string",
      "description": "International designator assigned to the space object."
    },
    "external_references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "object_marking_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "spec_version",
    "id",
    "created",
    "modified",
    "name",
    "asset_type"
  ],
  "additionalProperties": true
}