{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "x-orbital-state-change.schema.json",
    "title": "x-orbital-state-change",
    "description": "A STIX 2.1 SDO representing a change in orbital state based on a comparison of orbital data before and after an event.",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "x-orbital-state-change"
        },
        "spec_version": {
            "type": "string",
            "const": "2.1"
        },
        "id": {
            "type": "string",
            "pattern": "^x-orbital-state-change--[0-9a-fA-F-]{36}$"
        },
        "created_by_ref": {
            "type": "string",
            "pattern": "^identity--[0-9a-fA-F-]{36}$"
        },
        "created": {
            "type": "string",
            "format": "date-time"
        },
        "modified": {
            "type": "string",
            "format": "date-time"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        },
        "tle_before": {
            "type": "string",
            "description": "Two-Line Element data representing the orbital state before the observed change."
        },
        "tle_after": {
            "type": "string",
            "description": "Two-Line Element data representing the orbital state after the observed change."
        },
        "change_time": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which the orbital state change was observed or assessed."
        },
        "apogee_change_km": {
            "type": "number",
            "description": "Change in orbital apogee, in kilometers."
        },
        "perigee_change_km": {
            "type": "number",
            "description": "Change in orbital perigee, in kilometers."
        },
        "inclination_change_deg": {
            "type": "number",
            "description": "Change in orbital inclination, in degrees."
        },
        "external_references": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "object_marking_refs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "type",
        "spec_version",
        "id",
        "created",
        "modified",
        "name",
        "tle_before",
        "tle_after"
    ],
    "additionalProperties": true
}
