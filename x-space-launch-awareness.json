{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x-space-launch-awareness.schema.json",
  "title": "x-space-launch-awareness",
  "description": "A STIX 2.1 SDO representing launch timing and intended orbital information associated with a space launch.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "x-space-launch-awareness"
    },
    "spec_version": {
      "type": "string",
      "const": "2.1"
    },
    "id": {
      "type": "string",
      "pattern": "^x-space-launch-awareness--[0-9a-fA-F-]{36}$"
    },
    "created_by_ref": {
      "type": "string",
      "pattern": "^identity--[0-9a-fA-F-]{36}$"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "launch_date": {
      "type": "string",
      "format": "date-time",
      "description": "Planned or observed date and time of launch."
    },
    "launch_window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the planned launch window in UTC."
    },
    "launch_window_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the planned launch window in UTC."
    },
    "intended_altitude_km": {
      "type": "number",
      "minimum": 0,
      "description": "Intended orbital altitude in kilometers."
    },
    "intended_orbit": {
      "type": "string",
      "description": "Intended orbit or orbital regime for the launched object."
    },
    "intended_inclination_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 180,
      "description": "Intended orbital inclination in degrees."
    },
    "intended_slot": {
      "type": "string",
      "description": "Intended orbital slot or position when applicable."
    },
    "external_references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "object_marking_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "spec_version",
    "id",
    "created",
    "modified",
    "name",
    "launch_date"
  ],
  "additionalProperties": true
}