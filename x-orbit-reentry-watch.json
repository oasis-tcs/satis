{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x-orbit-reentry-watch.schema.json",
  "title": "x-orbit-reentry-watch",
  "description": "A STIX 2.1 SDO representing a monitored or predicted orbital reentry event.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "x-orbit-reentry-watch"
    },
    "spec_version": {
      "type": "string",
      "const": "2.1"
    },
    "id": {
      "type": "string",
      "pattern": "^x-orbit-reentry-watch--[0-9a-fA-F-]{36}$"
    },
    "created_by_ref": {
      "type": "string",
      "pattern": "^identity--[0-9a-fA-F-]{36}$"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "reentry_time": {
      "type": "string",
      "format": "date-time",
      "description": "Predicted or estimated UTC time of orbital reentry."
    },
    "uncertainty_minutes": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of minutes of uncertainty surrounding the predicted reentry time."
    },
    "external_references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "object_marking_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "spec_version",
    "id",
    "created",
    "modified",
    "name",
    "reentry_time",
    "uncertainty_minutes"
  ],
  "additionalProperties": true
}